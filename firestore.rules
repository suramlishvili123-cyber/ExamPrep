rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;

      match /attempts/{attemptId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
      match /activeAttempts/{documentId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId && documentId == "current";
      }
      match /settings/{documentId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId && documentId == "main";
      }
      match /targets/{documentId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId && documentId == "main";
      }
      match /notes/{documentId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId && documentId == "main";
      }
      match /questionProgress/{questionId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
      match /mistakeQueue/{questionId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /questions/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /papers/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /specTopics/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /scoreConversions/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /benchmarks/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /contentVersions/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
