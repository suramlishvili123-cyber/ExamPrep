{
  "id": "./",
  "name": "ESAT Atlas — Cambridge Engineering Preparation",
  "short_name": "ESAT Atlas",
  "description": "Sit ESAT past papers by year, take original challenge mocks, write your working on the built-in whiteboard, and review honest section-level analysis. Works fully offline once installed.",
  "lang": "en-GB",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f3f5f7",
  "theme_color": "#103f36",
  "categories": ["education", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Today's study plan",
      "short_name": "Study plan",
      "description": "Open the adaptive plan for today",
      "url": "./#/plan",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Build a practice session",
      "short_name": "Practice",
      "description": "Choose a module, filter and timing",
      "url": "./#/practice",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Mistakes due for redo",
      "short_name": "Mistakes",
      "description": "Work through the retrieval queue",
      "url": "./#/mistakes",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
